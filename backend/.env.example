# Copy this file to .env and fill in real values for local dev.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://gdtrainer:gdtrainer@localhost:5432/gdtrainer
# Sync URL used by Alembic (asyncpg driver isn't supported by Alembic's default runner)
DATABASE_URL_SYNC=postgresql+psycopg2://gdtrainer:gdtrainer@localhost:5432/gdtrainer

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Storage (local disk for dev) ---
STORAGE_DIR=./storage

# --- Transcription (wired in Day 2) ---
TRANSCRIBER_PROVIDER=local
WHISPER_MODEL=base.en

# --- Model layer (wired in Day 4) ---
# Azure Speech: free F0 tier, https://portal.azure.com -> create "Speech" resource
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Anthropic: https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5; override to e.g. claude-haiku-4-5 for a cheaper/faster
# argument-quality scorer if per-session LLM cost matters more than judgment quality.
ANTHROPIC_MODEL=claude-opus-5

# --- Email (Brevo transactional API, wired for auth hardening) ---
# https://app.brevo.com -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GD Trainer
# Used to build verify-email/reset-password links sent in emails.
FRONTEND_BASE_URL=http://localhost:3000

# --- Rooms (multi-party GD room MVP) ---
# LiveKit Cloud: https://cloud.livekit.io -> create a project (free tier) ->
# Settings -> Keys. LIVEKIT_URL is the project's wss:// URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Upper bound accepted for a room's max_participants (POST /rooms) — the design
# spec's cap. Requests above this get a 422.
ROOM_MAX_PARTICIPANTS=6
